.mentor-onboarding-page {
  min-height: 100vh;
  padding: 38px 22px 56px;
  color: #101419;
  background: #ffffff;
}

.mentor-onboarding-shell {
  width: min(1080px, 100%);
  margin: 0 auto;
}

.mentor-onboarding-heading {
  max-width: 760px;
  margin-bottom: 26px;
}

.mentor-onboarding-eyebrow {
  display: block;
  margin-bottom: 8px;
  color: #ff5303;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.mentor-onboarding-heading h1 {
  margin: 0;
  color: #101419;
  font-size: clamp(34px, 5vw, 52px);
  line-height: 1.05;
  letter-spacing: -0.04em;
}

.mentor-onboarding-heading p {
  max-width: 680px;
  margin: 13px 0 0;
  color: #667487;
  font-size: 15px;
  line-height: 1.7;
}

.mentor-onboarding-form {
  display: grid;
  gap: 18px;
}

.mentor-onboarding-card {
  display: grid;
  gap: 22px;
  padding: 26px;
  border: 1px solid #e2e7ed;
  border-radius: 18px;
  background: #ffffff;
}

.mentor-onboarding-card-heading {
  display: flex;
  align-items: flex-start;
  gap: 13px;
}

.mentor-onboarding-card-heading > span {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  place-items: center;
  border-radius: 10px;
  color: #ff5303;
  background: #fff1eb;
  font-size: 12px;
  font-weight: 800;
}

.mentor-onboarding-card-heading h2 {
  margin: 0;
  color: #101419;
  font-size: 20px;
  line-height: 1.3;
}

.mentor-onboarding-card-heading p {
  margin: 5px 0 0;
  color: #6f7d8e;
  font-size: 13px;
  line-height: 1.6;
}

.mentor-onboarding-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.mentor-onboarding-form label,
.mentor-onboarding-options {
  min-width: 0;
}

.mentor-onboarding-form label {
  display: grid;
  gap: 8px;
  color: #202831;
  font-size: 13px;
  font-weight: 700;
}

.mentor-onboarding-form input,
.mentor-onboarding-form select,
.mentor-onboarding-form textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #cbd4de;
  border-radius: 11px;
  color: #101419;
  background: #ffffff;
  font: inherit;
  font-size: 15px;
  font-weight: 400;
  outline: none;
}

.mentor-onboarding-form input,
.mentor-onboarding-form select {
  min-height: 52px;
  padding: 0 14px;
}

.mentor-onboarding-form textarea {
  min-height: 130px;
  padding: 14px;
  resize: vertical;
  line-height: 1.6;
}

.mentor-onboarding-form input:focus,
.mentor-onboarding-form select:focus,
.mentor-onboarding-form textarea:focus {
  border-color: #ff5303;
  box-shadow:
    0 0 0 3px
      rgba(255, 83, 3, 0.1);
}

.mentor-onboarding-form input:disabled,
.mentor-onboarding-form select:disabled,
.mentor-onboarding-form textarea:disabled {
  color: #6f7d8e;
  background: #f7f8fa;
}

.mentor-onboarding-form label > small {
  color: #8491a1;
  font-size: 11px;
  font-weight: 400;
  line-height: 1.5;
}

.mentor-onboarding-select-field {
  position: relative;
}

.mentor-onboarding-select-field select {
  appearance: none;
  padding-right: 44px;
}

.mentor-onboarding-select-field svg {
  position: absolute;
  top: 50%;
  right: 14px;
  color: #667487;
  pointer-events: none;
  transform: translateY(-50%);
}

.mentor-onboarding-options {
  margin: 0;
  padding: 0;
  border: 0;
}

.mentor-onboarding-options legend {
  margin-bottom: 10px;
  color: #202831;
  font-size: 13px;
  font-weight: 700;
}

.mentor-onboarding-option-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.mentor-onboarding-option-grid--categories {
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
}

.mentor-onboarding-option-grid label {
  display: flex;
  min-height: 50px;
  align-items: center;
  gap: 10px;
  padding: 11px 13px;
  border: 1px solid #e0e5eb;
  border-radius: 11px;
  background: #ffffff;
  cursor: pointer;
}

.mentor-onboarding-option-grid
  input[type="checkbox"],
.mentor-onboarding-option-grid
  input[type="radio"] {
  width: 18px;
  height: 18px;
  min-height: 18px;
  flex: 0 0 18px;
  margin: 0;
  padding: 0;
  accent-color: #ff5303;
  box-shadow: none;
}

.mentor-onboarding-option-grid
  label:has(input:checked) {
  border-color: #ff5303;
  background: #fffaf7;
}

.mentor-onboarding-option-grid span {
  font-size: 13px;
  font-weight: 500;
}

.mentor-onboarding-radio-grid {
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
}

/* ========================================
   REQUIRED PROFILE PHOTO
======================================== */

.mentor-onboarding-photo-card {
  overflow: hidden;
}

.mentor-onboarding-photo-layout {
  display: grid;
  grid-template-columns:
    190px minmax(0, 1fr);
  align-items: center;
  gap: 30px;
}

.mentor-onboarding-photo-preview-column {
  display: grid;
  justify-items: start;
  gap: 10px;
}

.mentor-onboarding-photo-input {
  display: none;
}

.mentor-onboarding-photo-preview {
  display: grid;
  width: 180px;
  height: 180px;
  overflow: hidden;
  place-items: center;
  border: 1px dashed #cbd4de;
  border-radius: 18px;
  background: #fafbfc;
}

.mentor-onboarding-photo-preview.has-photo {
  border-style: solid;
  border-color: #e0e5eb;
}

.mentor-onboarding-photo-preview img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center 22%;
}

.mentor-onboarding-photo-empty {
  display: grid;
  justify-items: center;
  gap: 9px;
  padding: 20px;
  color: #7b8795;
  text-align: center;
}

.mentor-onboarding-photo-empty svg {
  color: #ff5303;
}

.mentor-onboarding-photo-empty span {
  font-size: 12px;
  font-weight: 700;
}

.mentor-onboarding-photo-file-help {
  display: block;
  max-width: 180px;
  color: #8491a1;
  font-size: 11px;
  font-weight: 400;
  line-height: 1.5;
}

.mentor-onboarding-photo-details {
  display: grid;
  justify-items: start;
  gap: 10px;
  text-align: left;
}

.mentor-onboarding-photo-required {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  padding: 4px 9px;
  border-radius: 999px;
  color: #ff5303;
  background: #fff1eb;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.mentor-onboarding-photo-details h3 {
  margin: 2px 0 0;
  color: #101419;
  font-size: 21px;
  line-height: 1.3;
}

.mentor-onboarding-photo-details > p {
  max-width: 650px;
  margin: 0;
  color: #667487;
  font-size: 13px;
  line-height: 1.7;
}

.mentor-onboarding-photo-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin-top: 4px;
}

.mentor-onboarding-photo-upload-button,
.mentor-onboarding-photo-remove-button {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 15px;
  border-radius: 10px;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition:
    border-color 160ms ease,
    background 160ms ease,
    color 160ms ease,
    opacity 160ms ease;
}

.mentor-onboarding-photo-upload-button {
  border: 1px solid #ff5303;
  color: #ffffff;
  background: #ff5303;
}

.mentor-onboarding-photo-upload-button:hover:not(
    :disabled
  ) {
  background: #eb4c00;
}

.mentor-onboarding-photo-remove-button {
  border: 1px solid #d7dde5;
  color: #485565;
  background: #ffffff;
}

.mentor-onboarding-photo-remove-button:hover:not(
    :disabled
  ) {
  border-color: #b9c3ce;
  background: #f8f9fb;
}

.mentor-onboarding-photo-upload-button:disabled,
.mentor-onboarding-photo-remove-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.mentor-onboarding-photo-warning {
  margin: 2px 0 0 !important;
  color: #b54708 !important;
  font-size: 12px !important;
  font-weight: 600;
  line-height: 1.55 !important;
}

/* ========================================
   REVIEW NOTE / ACTIONS
======================================== */

.mentor-onboarding-review-note {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  padding: 15px 16px;
  border: 1px solid #e0e5eb;
  border-radius: 12px;
  color: #526071;
  background: #fafbfc;
}

.mentor-onboarding-review-note svg {
  flex: 0 0 auto;
  color: #ff5303;
}

.mentor-onboarding-review-note p {
  margin: 0;
  font-size: 12px;
  line-height: 1.65;
}

.mentor-onboarding-error {
  margin: 0;
}

.mentor-onboarding-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 2px;
}

.mentor-onboarding-actions
  .primary-button {
  min-width: 220px;
}

.mentor-onboarding-actions
  .primary-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* ========================================
   TABLET
======================================== */

@media (max-width: 820px) {
  .mentor-onboarding-grid,
  .mentor-onboarding-option-grid--categories,
  .mentor-onboarding-radio-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .mentor-onboarding-photo-layout {
    grid-template-columns:
      160px minmax(0, 1fr);
    gap: 24px;
  }

  .mentor-onboarding-photo-preview {
    width: 155px;
    height: 155px;
  }

  .mentor-onboarding-photo-file-help {
    max-width: 155px;
  }
}

/* ========================================
   MOBILE
======================================== */

@media (max-width: 620px) {
  .mentor-onboarding-page {
    padding:
      26px 16px 42px;
  }

  .mentor-onboarding-heading h1 {
    font-size: 36px;
  }

  .mentor-onboarding-card {
    padding: 20px 16px;
    border-radius: 15px;
  }

  .mentor-onboarding-grid,
  .mentor-onboarding-option-grid,
  .mentor-onboarding-option-grid--categories {
    grid-template-columns: 1fr;
  }

  .mentor-onboarding-radio-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .mentor-onboarding-form input,
  .mentor-onboarding-form select,
  .mentor-onboarding-form textarea {
    font-size: 16px;
  }

  .mentor-onboarding-photo-layout {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .mentor-onboarding-photo-preview-column {
    width: 100%;
  }

  .mentor-onboarding-photo-preview {
    width: 150px;
    height: 150px;
  }

  .mentor-onboarding-photo-file-help {
    max-width: none;
  }

  .mentor-onboarding-photo-details {
    width: 100%;
  }

  .mentor-onboarding-photo-actions {
    width: 100%;
  }

  .mentor-onboarding-photo-upload-button,
  .mentor-onboarding-photo-remove-button {
    width: 100%;
  }

  .mentor-onboarding-actions
    .primary-button {
    width: 100%;
  }
}

/* =========================================================
   FINAL MENTORING OPTION FOCUS
   Keep the option border thin and neutral.
   ========================================================= */

.mentor-onboarding-form label:has(input[type="checkbox"]),
.mentor-application-form label:has(input[type="checkbox"]) {
  border-width: 1px !important;
  box-shadow: none !important;
}

.mentor-onboarding-form label:has(input[type="checkbox"]:checked),
.mentor-application-form label:has(input[type="checkbox"]:checked) {
  border: 1px solid #4c5867 !important;
  background: #ffffff !important;
  box-shadow: none !important;
}

.mentor-onboarding-form input[type="checkbox"],
.mentor-application-form input[type="checkbox"] {
  accent-color: #ff5303 !important;
}

.mentor-onboarding-form input[type="checkbox"]:focus,
.mentor-onboarding-form input[type="checkbox"]:focus-visible,
.mentor-application-form input[type="checkbox"]:focus,
.mentor-application-form input[type="checkbox"]:focus-visible {
  outline: 1px solid #97aac2 !important;
  outline-offset: 2px !important;
  box-shadow: none !important;
}
